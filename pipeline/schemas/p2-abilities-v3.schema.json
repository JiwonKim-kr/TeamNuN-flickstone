{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flickstone.local/schemas/p2-abilities-v3.schema.json",
  "$defs": {
    "selector": {
      "type": "object", "additionalProperties": false,
      "required": ["kind_id", "relation_id", "limit"],
      "properties": {
        "kind_id": {"type": "integer", "minimum": 1, "maximum": 8},
        "relation_id": {"const": 0},
        "limit": {"type": "integer", "minimum": 0, "maximum": 256}
      }
    },
    "condition": {
      "type": "object", "additionalProperties": false,
      "required": ["kind_id", "relation_id", "value_a", "value_b"],
      "properties": {
        "kind_id": {"type": "integer", "minimum": 1, "maximum": 7},
        "relation_id": {"type": "integer", "minimum": 0, "maximum": 4},
        "value_a": {"type": "integer"}, "value_b": {"type": "integer"}
      }
    },
    "effect": {
      "type": "object", "additionalProperties": false,
      "required": ["kind_id", "selector", "value_a", "value_b", "operation_id"],
      "properties": {
        "kind_id": {"enum": [1, 2, 3, 4, 5, 6, 7, 10, 11]},
        "selector": {"$ref": "#/$defs/selector"},
        "value_a": {"type": "integer"}, "value_b": {"type": "integer"},
        "operation_id": {"type": "integer", "minimum": 0, "maximum": 1}
      }
    }
  },
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": {"const": 3},
    "records": {
      "type": "array", "maxItems": 4096,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["numeric_id", "id", "trigger_id", "conditions", "effects"],
        "properties": {
          "numeric_id": {"type": "integer", "minimum": 1, "maximum": 4294967295},
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "trigger_id": {"type": "integer", "minimum": 1, "maximum": 13},
          "conditions": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/condition"}},
          "effects": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/effect"}}
        }
      }
    }
  }
}
