{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flickstone.local/schemas/p5-pieces-v4.schema.json",
  "$defs": {
    "content_ref": {"type":"object","additionalProperties":false,"required":["numeric_id","id"],"properties":{"numeric_id":{"type":"integer","minimum":1,"maximum":4294967295},"id":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,63}$"}}},
    "level": {"type":"object","additionalProperties":false,"required":["level","max_hp","attack","speed_stat","mass_raw","radius_raw","friction_multiplier_raw","elasticity_multiplier_raw","critical_basis_points","ability_refs"],"properties":{"level":{"type":"integer","minimum":1,"maximum":3},"max_hp":{"type":"integer","minimum":1,"maximum":1000000},"attack":{"type":"integer","minimum":1,"maximum":1000000},"speed_stat":{"type":"integer","minimum":50,"maximum":200},"mass_raw":{"type":"integer","minimum":65536,"maximum":16777216},"radius_raw":{"type":"integer","minimum":524288,"maximum":8388608},"friction_multiplier_raw":{"type":"integer","minimum":0,"maximum":9223372036854775807},"elasticity_multiplier_raw":{"type":"integer","minimum":65536,"maximum":262144},"critical_basis_points":{"type":"integer","minimum":0,"maximum":10000},"ability_refs":{"type":"array","maxItems":32,"items":{"$ref":"#/$defs/content_ref"}}}}
  },
  "type":"object","additionalProperties":false,"required":["schema_version","records"],
  "properties":{"schema_version":{"const":4},"records":{"type":"array","maxItems":4096,"items":{"type":"object","additionalProperties":false,"required":["numeric_id","id","flags","spawnable","spawn_faction_mode_id","expire_kind_id","expire_value","attach_anchor_mode_id","attach_anchor_offset_x_raw","attach_anchor_offset_y_raw","tag_refs","levels"],"properties":{"numeric_id":{"type":"integer","minimum":1,"maximum":4294967295},"id":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,63}$"},"flags":{"type":"object","additionalProperties":false,"required":["has_turn","destructible","transformable","counts_for_victory","is_token"],"properties":{"has_turn":{"type":"boolean"},"destructible":{"type":"boolean"},"transformable":{"type":"boolean"},"counts_for_victory":{"type":"boolean"},"is_token":{"type":"boolean"}}},"spawnable":{"type":"boolean"},"spawn_faction_mode_id":{"enum":[1,2]},"expire_kind_id":{"enum":[1,2,3,4]},"expire_value":{"type":"integer","minimum":0,"maximum":1024},"attach_anchor_mode_id":{"enum":[1,2,3]},"attach_anchor_offset_x_raw":{"type":"integer"},"attach_anchor_offset_y_raw":{"type":"integer"},"tag_refs":{"type":"array","maxItems":8,"items":{"$ref":"#/$defs/content_ref"}},"levels":{"type":"array","minItems":1,"maxItems":3,"items":{"$ref":"#/$defs/level"}}}}}}
