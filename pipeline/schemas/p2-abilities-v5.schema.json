{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flickstone.local/schemas/p2-abilities-v5.schema.json",
  "$defs": {
    "content_ref": {"type": "object", "additionalProperties": false, "required": ["numeric_id", "id"], "properties": {"numeric_id": {"type": "integer", "minimum": 1, "maximum": 4294967295}, "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}}},
    "point": {"type": "object", "additionalProperties": false, "required": ["x_raw", "y_raw"], "properties": {"x_raw": {"type": "integer", "minimum": -536870912, "maximum": 536870912}, "y_raw": {"type": "integer", "minimum": -536870912, "maximum": 536870912}}},
    "selector": {"type": "object", "additionalProperties": false, "required": ["kind_id", "relation_id", "limit"], "properties": {"kind_id": {"type": "integer", "minimum": 1, "maximum": 8}, "relation_id": {"const": 0}, "limit": {"type": "integer", "minimum": 0, "maximum": 256}}},
    "condition": {"type": "object", "additionalProperties": false, "required": ["kind_id", "relation_id", "value_a", "value_b"], "properties": {"kind_id": {"type": "integer", "minimum": 1, "maximum": 7}, "relation_id": {"type": "integer", "minimum": 0, "maximum": 4}, "value_a": {"type": "integer"}, "value_b": {"type": "integer"}}},
    "base_effect": {"type": "object", "required": ["kind_id", "selector", "value_a", "value_b", "operation_id"], "properties": {"kind_id": {"enum": [1,2,3,4,5,6,7,10,11]}, "selector": {"$ref": "#/$defs/selector"}, "value_a": {"type": "integer"}, "value_b": {"type": "integer"}, "operation_id": {"type": "integer", "minimum": 0, "maximum": 1}}, "unevaluatedProperties": false},
    "zone_effect": {"type": "object", "additionalProperties": false, "required": ["kind_id", "selector", "value_a", "value_b", "operation_id", "zone"], "properties": {"kind_id": {"const": 16}, "selector": {"$ref": "#/$defs/selector"}, "value_a": {"const": 0}, "value_b": {"const": 0}, "operation_id": {"const": 0}, "zone": {"type": "object", "additionalProperties": false, "required": ["flags", "friction_multiplier_raw", "acceleration_x_raw", "acceleration_y_raw", "offset_x_raw", "offset_y_raw", "vertices", "duration_turns"], "properties": {"flags": {"enum": [0,1]}, "friction_multiplier_raw": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}, "acceleration_x_raw": {"type": "integer", "minimum": -536870912, "maximum": 536870912}, "acceleration_y_raw": {"type": "integer", "minimum": -536870912, "maximum": 536870912}, "offset_x_raw": {"type": "integer", "minimum": -536870912, "maximum": 536870912}, "offset_y_raw": {"type": "integer", "minimum": -536870912, "maximum": 536870912}, "vertices": {"type": "array", "minItems": 3, "maxItems": 64, "items": {"$ref": "#/$defs/point"}}, "duration_turns": {"type": "integer", "minimum": 0, "maximum": 1024}}}}},
    "effect": {"oneOf": [{"$ref": "p2-abilities-v4.schema.json#/$defs/spawn_effect"}, {"$ref": "p2-abilities-v4.schema.json#/$defs/transform_effect"}, {"$ref": "p2-abilities-v4.schema.json#/$defs/attach_effect"}, {"$ref": "#/$defs/base_effect"}, {"$ref": "#/$defs/zone_effect"}]}
  },
  "type": "object", "additionalProperties": false, "required": ["schema_version", "records"],
  "properties": {"schema_version": {"const": 5}, "records": {"type": "array", "maxItems": 4096, "items": {"type": "object", "additionalProperties": false, "required": ["numeric_id", "id", "trigger_id", "conditions", "effects"], "properties": {"numeric_id": {"type": "integer", "minimum": 1, "maximum": 4294967295}, "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}, "trigger_id": {"type": "integer", "minimum": 1, "maximum": 13}, "conditions": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/condition"}}, "effects": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/effect"}}}}}}
}
