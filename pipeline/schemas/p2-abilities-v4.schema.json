{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://flickstone.local/schemas/p2-abilities-v4.schema.json",
  "$defs":{
    "content_ref":{"type":"object","additionalProperties":false,"required":["numeric_id","id"],"properties":{"numeric_id":{"type":"integer","minimum":1,"maximum":4294967295},"id":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,63}$"}}},
    "selector":{"type":"object","additionalProperties":false,"required":["kind_id","relation_id","limit"],"properties":{"kind_id":{"type":"integer","minimum":1,"maximum":8},"relation_id":{"const":0},"limit":{"type":"integer","minimum":0,"maximum":256}}},
    "condition":{"type":"object","additionalProperties":false,"required":["kind_id","relation_id","value_a","value_b"],"properties":{"kind_id":{"type":"integer","minimum":1,"maximum":7},"relation_id":{"type":"integer","minimum":0,"maximum":4},"value_a":{"type":"integer"},"value_b":{"type":"integer"}}},
    "base_effect":{"type":"object","required":["kind_id","selector","value_a","value_b","operation_id"],"properties":{"kind_id":{"enum":[1,2,3,4,5,6,7,10,11]},"selector":{"$ref":"#/$defs/selector"},"value_a":{"type":"integer"},"value_b":{"type":"integer"},"operation_id":{"type":"integer","minimum":0,"maximum":1}},"unevaluatedProperties":false},
    "spawn_effect":{"type":"object","required":["kind_id","selector","value_a","value_b","operation_id","spawn"],"properties":{"kind_id":{"enum":[12,13]},"selector":{"$ref":"#/$defs/selector"},"value_a":{"const":0},"value_b":{"const":0},"operation_id":{"const":0},"spawn":{"type":"object","additionalProperties":false,"required":["piece_ref","offset_x_raw","offset_y_raw","speed_raw","direction_mode_id"],"properties":{"piece_ref":{"$ref":"#/$defs/content_ref"},"offset_x_raw":{"type":"integer"},"offset_y_raw":{"type":"integer"},"speed_raw":{"type":"integer","minimum":0,"maximum":134217728},"direction_mode_id":{"enum":[1,2,3]}}}},"unevaluatedProperties":false},
    "transform_effect":{"type":"object","required":["kind_id","selector","value_a","value_b","operation_id","transform"],"properties":{"kind_id":{"const":14},"selector":{"$ref":"#/$defs/selector"},"value_a":{"const":0},"value_b":{"const":0},"operation_id":{"const":0},"transform":{"type":"object","additionalProperties":false,"required":["piece_ref"],"properties":{"piece_ref":{"$ref":"#/$defs/content_ref"}}}},"unevaluatedProperties":false},
    "attach_effect":{"type":"object","required":["kind_id","selector","value_a","value_b","operation_id","attach"],"properties":{"kind_id":{"const":15},"selector":{"$ref":"#/$defs/selector"},"value_a":{"const":0},"value_b":{"const":0},"operation_id":{"const":0},"attach":{"type":"object","additionalProperties":false,"required":["owner_role_id","anchor_mode_id","anchor_offset_x_raw","anchor_offset_y_raw","attach_distance_raw","inertia_basis_points","duration_turns"],"properties":{"owner_role_id":{"enum":[1,2]},"anchor_mode_id":{"enum":[1,2,3]},"anchor_offset_x_raw":{"type":"integer"},"anchor_offset_y_raw":{"type":"integer"},"attach_distance_raw":{"type":"integer","minimum":0,"maximum":8388608},"inertia_basis_points":{"type":"integer","minimum":1,"maximum":10000},"duration_turns":{"type":"integer","minimum":1,"maximum":1024}}}},"unevaluatedProperties":false},
    "effect":{"oneOf":[{"$ref":"#/$defs/base_effect"},{"$ref":"#/$defs/spawn_effect"},{"$ref":"#/$defs/transform_effect"},{"$ref":"#/$defs/attach_effect"}]}
  },
  "type":"object","additionalProperties":false,"required":["schema_version","records"],"properties":{"schema_version":{"const":4},"records":{"type":"array","maxItems":4096,"items":{"type":"object","additionalProperties":false,"required":["numeric_id","id","trigger_id","conditions","effects"],"properties":{"numeric_id":{"type":"integer","minimum":1,"maximum":4294967295},"id":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,63}$"},"trigger_id":{"type":"integer","minimum":1,"maximum":13},"conditions":{"type":"array","maxItems":16,"items":{"$ref":"#/$defs/condition"}},"effects":{"type":"array","maxItems":32,"items":{"$ref":"#/$defs/effect"}}}}}}
}
