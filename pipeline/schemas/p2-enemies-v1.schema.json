{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flickstone.local/schemas/p2-enemies-v1.schema.json",
  "$defs": {
    "content_ref": {
      "type": "object", "additionalProperties": false, "required": ["numeric_id", "id"],
      "properties": {"numeric_id": {"type": "integer", "minimum": 1, "maximum": 4294967295}, "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}}
    }
  },
  "type": "object", "additionalProperties": false, "required": ["schema_version", "records"],
  "properties": {
    "schema_version": {"const": 1},
    "records": {"type": "array", "maxItems": 4096, "items": {
      "type": "object", "additionalProperties": false, "required": ["numeric_id", "id", "base_piece_ref", "override"],
      "properties": {
        "numeric_id": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
        "base_piece_ref": {"$ref": "#/$defs/content_ref"},
        "override": {"type": "object", "additionalProperties": false, "properties": {
          "max_hp": {"type": "integer", "minimum": 1, "maximum": 1000000},
          "attack": {"type": "integer", "minimum": 1, "maximum": 1000000},
          "speed_stat": {"type": "integer", "minimum": 50, "maximum": 200},
          "mass_raw": {"type": "integer", "minimum": 65536, "maximum": 16777216},
          "radius_raw": {"type": "integer", "minimum": 524288, "maximum": 8388608},
          "friction_multiplier_raw": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
          "critical_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000},
          "ability_refs": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/content_ref"}}
        }}
      }
    }}
  }
}
